{
  "openapi": "3.0.3",
  "info": {
    "title": "API JWT local",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://api:3000"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Disponible"
          }
        }
      }
    },
    "/api/admin": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Admin autorizado"
          },
          "401": {
            "description": "Token ausente o inv\u00e1lido"
          },
          "403": {
            "description": "Rol insuficiente"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
